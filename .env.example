# SARATHI configuration for docker compose. PLACEHOLDERS ONLY - copy to .env and edit.
# Never commit .env. In Kubernetes these come from a Secret (see infra/k8s).
# Passwords are embedded in connection URLs: use URL-safe characters (A-Z a-z 0-9 - _).

# --- shared ---
# local | staging | production
SARATHI_ENV=local
POSTGRES_USER=sarathi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sarathi
REDIS_PASSWORD=change-me-local-only
MONGO_USER=sarathi
MONGO_PASSWORD=change-me-local-only

# Host ports published on 127.0.0.1 by docker compose.
SARATHI_WEB_PORT=3000
SARATHI_API_PORT=8080

# --- API secrets (generate each with: openssl rand -hex 32) ---
# Signs access tokens and derives OTP hashes and boarding codes. Min 32 chars.
SARATHI_JWT_SECRET=change-me-generate-64-hex-characters-with-openssl-rand
# Presented by cab gateways as X-Gateway-Token on /internal/v1/gateway/usage.
SARATHI_GATEWAY_TOKEN=change-me-generate-64-hex-characters-with-openssl-rand

# --- API behaviour ---
SARATHI_LOG_LEVEL=info
# Comma-separated E.164 numbers that become admins when they sign in.
SARATHI_ADMIN_PHONES=
# Extra browser origins allowed to call the API. Not needed when the web app and API
# share an origin, which is the default. Wildcard is rejected in production.
SARATHI_CORS_ALLOWED_ORIGINS=

# OTP delivery. local default: "log" (code is logged and echoed to the client).
# Outside local the default is "webhook", which POSTs {"to","message"} with a bearer token.
SARATHI_OTP_SENDER=
SARATHI_OTP_WEBHOOK_URL=
SARATHI_OTP_WEBHOOK_TOKEN=

# Payments. local default: "mock" (no money moves). Outside local the default is "none":
# Wi-Fi plan purchases are refused until a real provider is integrated.
SARATHI_PAYMENT_PROVIDER=

# Demo fleet. Defaults to on in local and off elsewhere. Set true to demo on staging.
SARATHI_SIMULATOR=
SARATHI_SIMULATOR_CABS=
SARATHI_SIMULATOR_RATE=

# --- AI service ---
SARATHI_AI_SERVICE_TOKEN=change-me-generate-a-long-random-value
