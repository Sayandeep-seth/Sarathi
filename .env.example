# SARATHI local development configuration. PLACEHOLDERS ONLY - copy to .env and edit.
# Never commit .env. Production secrets come from your secret manager, not this file.

# --- shared ---
SARATHI_ENV=local                      # local | staging | production
POSTGRES_USER=sarathi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sarathi
REDIS_PASSWORD=change-me-local-only

# --- API ---
SARATHI_LOG_LEVEL=info
SARATHI_REQUEST_TIMEOUT=10s
SARATHI_SHUTDOWN_TIMEOUT=15s
SARATHI_MAX_BODY_BYTES=1048576
# Comma-separated exact origins. Wildcard is rejected in production.
SARATHI_CORS_ALLOWED_ORIGINS=

# --- AI service ---
# Shared secret the API presents as X-Service-Token. Generate: openssl rand -hex 32
SARATHI_AI_SERVICE_TOKEN=change-me-generate-a-long-random-value
